# Copiar como .env y completar. El archivo .env NO se sube al repositorio ni al zip.

# Conexión a PostgreSQL: usuario, contraseña, host, puerto y base.
# (Para desarrollo también se acepta SQLite: DATABASE_URL=sqlite:///./foodstore.db)
DATABASE_URL=postgresql://postgres:<tu_contraseña>@localhost:5432/foodstore_db

# Firma del JWT: al menos 32 caracteres. Para generar una:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (varios: separados por coma)
FRONTEND_ORIGIN=http://localhost:5173

# Cookie con atributo Secure (solo HTTPS). En desarrollo: false
COOKIE_SECURE=false
